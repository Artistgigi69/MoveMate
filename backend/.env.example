# Copy to backend/.env and fill in. Never commit the real .env.

MONGO_URI=mongodb://127.0.0.1:27017/movemate
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000

# Where uploads are stored (uploads/ and private_uploads/ go inside it).
# Leave empty locally; on Render it's the persistent disk, /var/data.
STORAGE_DIR=

# Used in links the backend generates (e.g. payment callbacks).
FRONTEND_URL=http://localhost:5174

# SMTP for arnona letters to municipalities — leave blank to mark arnona
# requests "manual" instead of emailing them.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the address,
# SMTP_PASS=an app password (not the account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cardcom payment gateway — leave blank until you have a merchant account.
CARDCOM_TERMINAL=
CARDCOM_API_NAME=

# Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
